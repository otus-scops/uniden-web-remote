# =====================================================================
# Uniden BCT15X Web Remote - Environment Configuration Example
# =====================================================================
# Copy this file to '.env' and edit the values to match your system.
# Command: cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. Serial Port Settings (Hardware Connection to BCT15X)
# ---------------------------------------------------------------------
# Serial device path on the host machine.
# Check your device using: ls -l /dev/ttyUSB* or dmesg | grep tty
SERIAL_PORT=/dev/ttyUSB0

# Baud rate for scanner communication (Default: 115200)
# Ensure this matches the scanner's RS232 setting: MENU -> System -> Set Serial Port
SERIAL_BAUD=115200

# ---------------------------------------------------------------------
# 2. Audio Capture Settings (ALSA Hardware)
# ---------------------------------------------------------------------
# ALSA recording device identifier.
# Check available devices using: arecord -l
# Example USB audio card: plughw:1,0 (Card 1, Device 0)
# Example built-in sound card: plughw:0,0
AUDIO_DEVICE=plughw:1,0

# Audio recording format (mp3)
AUDIO_FORMAT=mp3

# Sampling rate in Hz (Default: 16000)
# 16000Hz is optimized for human voice and narrow-band radio scanners
AUDIO_SAMPLE_RATE=16000

# Audio channels (1 = Mono, 2 = Stereo)
AUDIO_CHANNELS=1

# MP3 Bitrate in kbps (Default: 32)
# 32kbps mono reduces storage by ~50% (approx. 14.4 MB / hour) while keeping clear speech
AUDIO_BITRATE=32

# Enable automatic recording upon squelch opening (true / false)
AUTO_RECORD=true

# SoX silence threshold percentage (Default: 1.0)
SILENCE_THRESHOLD=1.0

# Silence duration before ending recording in seconds (Default: 3.0)
SILENCE_DURATION=3.0

# ---------------------------------------------------------------------
# 3. Storage Retention Policy (Automatic Cleanup)
# ---------------------------------------------------------------------
# Number of days to retain recording files before auto-deletion (Default: 30)
# Set to 0 to retain recordings indefinitely (no expiration)
RETENTION_DAYS=30

# Maximum storage capacity in megabytes (MB) for recordings folder (Default: 0)
# When total size exceeds this, oldest files are pruned first. (0 = unlimited)
MAX_STORAGE_MB=0

# Periodic cleanup job interval in hours (Default: 12)
CLEANUP_INTERVAL_HOURS=12

# ---------------------------------------------------------------------
# 4. Role-Based Access Authentication (Optional)
# ---------------------------------------------------------------------
# Enable role separation between Operators and Listeners (true / false)
# When set to false, all visitors have full unrestricted operator access.
AUTH_ENABLED=false

# Operator password: required for scanner keypad/controls, memory editor, and deleting recordings
OPERATOR_PASSWORD=change_this_to_a_secure_operator_password

# Listener password: required to view scanner and listen to audio (leave empty to allow public listening)
LISTENER_PASSWORD=

# Session token secret (random string, auto-generated if omitted)
# AUTH_SECRET=your_custom_secret_key

# ---------------------------------------------------------------------
# 5. Filename & Directory Template
# ---------------------------------------------------------------------
# Template pattern for recording paths. Slashes '/' create nested directories.
# Available variables:
#   {system}     : System name (alpha tag)
#   {department} : Department name
#   {channel}    : Channel name
#   {freq}       : Frequency (MHz) or TGID
#   {date}       : Date (YYYY-MM-DD)
#   {time}       : Time (HH-MM-SS)
#   {modulation} : Modulation mode (AM, FM, NFM, etc.)
# Default: {system}/{department}/{channel}/{date}_{time}_{freq}
FILENAME_TEMPLATE={system}/{department}/{channel}/{date}_{time}_{freq}

# ---------------------------------------------------------------------
# 6. Scanner Polling & Timing
# ---------------------------------------------------------------------
# Fast status polling interval in ms (GLG command, Default: 200)
POLL_INTERVAL=200

# Full status polling interval in ms (STS command, Default: 1000)
STATUS_INTERVAL=1000

# Signal drop timeout in ms to consider transmission ended (Default: 1500)
RECEPTION_TIMEOUT=1500

# Maximum reception log records stored in server memory (Default: 10000)
MAX_LOG_ENTRIES=10000

# ---------------------------------------------------------------------
# 7. System & Development Settings
# ---------------------------------------------------------------------
# Server timezone
TZ=Asia/Tokyo

# Mock mode: set to true for UI development without physical scanner hardware (Default: false)
MOCK_MODE=false
